# Copy this file to .env.local and fill in your Supabase project credentials.
# Until these are set, the site falls back to local seed data automatically.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (daily auto-publish pipeline, /api/publish) ---
# Required only if you run the daily cron. Set these in Vercel project
# settings (never exposed to the browser).

# Anthropic API key — powers the curator/editor agents
ANTHROPIC_API_KEY=

# Supabase SECRET key (sb_secret_...) — lets the pipeline insert editions.
# Never use this in any NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Random string protecting /api/publish. Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=
